# Copy to `.env` for local development. NEVER commit `.env`.
# This file lists variable NAMES only. No real values belong here.
#
# In AWS, none of these come from a file: non-secret config is set on the ECS
# task definition, secrets are injected from SSM Parameter Store / Secrets
# Manager, and AWS access uses the ECS task IAM role (no access keys anywhere).

# --- App -----------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Public origin the browser uses. It builds the OAuth redirect URI and is what the Origin check on
# state-changing requests is compared against (we never trust Host/X-Forwarded-* headers for this).
# Local, backend on its own: http://localhost:8000. In AWS: the https CloudFront URL.
PUBLIC_BASE_URL=http://localhost:8000
# Session cookie is `Secure` (HTTPS only). false for plain-HTTP localhost; MUST be true in
# production (APP_ENV=production refuses to start otherwise, and must use an https PUBLIC_BASE_URL).
COOKIE_SECURE=false
# A session lasts exactly this long from login and is never renewed by use (168 hours = 7 days).
SESSION_LIFETIME_HOURS=168

# --- Database (local docker compose) ---------------------------------------
# Two roles (see docker/postgres-init/01-roles-and-databases.sh):
#   POSTGRES_USER  = the privileged MIGRATION role (the RDS master user on AWS).
#   APP_DB_USER    = the RUNTIME role the API connects as. No DDL rights.
# Choose your own passwords (letters and digits are safest inside a URL). Never commit `.env`.
POSTGRES_USER=stock_admin
POSTGRES_PASSWORD=
POSTGRES_DB=stock_analyst
APP_DB_USER=stock_app
APP_DB_PASSWORD=
# Host port for the local database. Change it if you already run PostgreSQL on 5432.
DB_PORT=5432
# What the API uses: the RUNTIME role, never the migration role.
# Shape: postgresql+asyncpg://<APP_DB_USER>:<APP_DB_PASSWORD>@127.0.0.1:<DB_PORT>/<POSTGRES_DB>
DATABASE_URL=
#
# MIGRATION_DATABASE_URL (the privileged migration role, used only by Alembic) does NOT belong in
# this file. The API's Settings never reads it, and it must stay out of the API's reach. Export it in
# your shell, or put ONLY that one line in a separate git-ignored `.env.migration` at the repo root:
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<DB_PORT>/<POSTGRES_DB>
# A real environment variable takes precedence over the file. On AWS it exists only in the one-off
# migration task, never in the api or worker containers.

# --- AWS / Bedrock (IAM auth, no API keys) ---------------------------------
# Local dev: a named profile created with `aws login --profile <name>`.
# Do NOT put AWS access keys in this file.
AWS_REGION=ap-south-1
AWS_PROFILE=
# Chosen in ADR 010. Never hardcode model IDs in source.
BEDROCK_CHAT_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Must match the embedding model's output size; it fixes the pgvector column type.
EMBEDDING_DIM=1024

# --- Google OAuth (GCP project used for sign-in only, no extra scopes) -----
# ALL THREE OF THESE ARE REQUIRED: the API refuses to start without them, so a deployment that
# could not complete a login fails immediately instead of at the moment a user clicks "Sign in".
# Create your own OAuth client (type: Web application) and register the redirect URI exactly:
#   <PUBLIC_BASE_URL>/api/v1/auth/google/callback
# The client ID is not secret (it appears in every authorization URL); the client secret is, and it
# is only ever sent server-to-server. Scopes requested: openid and email, nothing else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How long our server-to-server calls to Google may take (seconds, 1-120).
GOOGLE_TIMEOUT_SECONDS=5

# --- Sessions --------------------------------------------------------------
# Long random string, MINIMUM 32 characters; generate locally, never reuse across environments.
# It keys the signature on the short-lived login cookie, so a guessable value would let anyone
# forge the OAuth `state`. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# How long a started login may take to come back from Google (seconds, 60-3600).
OAUTH_LOGIN_TTL_SECONDS=600
