# Copy to `.env` for local development. NEVER commit `.env`.
# This file lists variable NAMES only. No real values belong here.
#
# In AWS, none of these come from a file: non-secret config is set on the ECS
# task definition, secrets are injected from SSM Parameter Store / Secrets
# Manager, and AWS access uses the ECS task IAM role (no access keys anywhere).

# --- App -----------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Public origin the browser uses. Used to build the OAuth redirect URI
# (we do not trust Host/X-Forwarded-* headers for this).
PUBLIC_BASE_URL=http://localhost:5173

# --- Database ------------------------------------------------------------
# Shape: postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# --- AWS / Bedrock (IAM auth, no API keys) ---------------------------------
# Local dev: use a named profile (e.g. `aws sso login --profile <name>`).
# Do NOT put AWS access keys in this file.
AWS_REGION=
AWS_PROFILE=
# Model IDs are intentionally blank: verify availability in the account first
# (see the project notes "Open items"), then set here. Never hardcode in source.
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
# Must match the embedding model's output size; it fixes the pgvector column type.
EMBEDDING_DIM=

# --- Google OAuth (GCP project used for sign-in only, no extra scopes) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sessions --------------------------------------------------------------
# Long random string; generate locally, never reuse across environments.
SESSION_SECRET=
